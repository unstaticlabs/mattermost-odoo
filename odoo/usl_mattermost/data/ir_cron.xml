<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sends "task changed" to the Mattermost plugin. A task write starts
         it at once (_usl_mark_changed); this interval only retries failures. -->
    <record id="ir_cron_push_cards" model="ir.cron">
        <field name="name">Mattermost: refresh task cards</field>
        <field name="model_id" ref="model_usl_mattermost_card"/>
        <field name="state">code</field>
        <field name="code">model._cron_push()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
